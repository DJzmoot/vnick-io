---
import { Image } from 'astro:assets';
import '../styles/global.css';
import logoMark from '../assets/brand/logo-mark.png';

interface Props {
  title: string;
  description: string;
  /** "article" on post pages so shares and crawlers treat them as writing. */
  ogType?: 'website' | 'article';
  /** ISO date, articles only. */
  publishedTime?: string;
  /** Topic name, articles only. */
  section?: string;
  /** Keep a page out of the index (used by 404). */
  noindex?: boolean;
}

const { title, description, ogType = 'website', publishedTime, section, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const path = Astro.url.pathname;
const current = (prefix: string) =>
  path === prefix || (prefix !== '/' && path.startsWith(prefix)) ? 'page' : undefined;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Nick Manganiello" />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="vNick.io" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="vNick.io — design, build, control" />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{ogType === 'article' && <meta property="article:author" content="Nick Manganiello" />}
{ogType === 'article' && section && <meta property="article:section" content={section} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="vNick.io — design, build, control" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#1a1c20" />
<link rel="alternate" type="application/rss+xml" title="vNick.io — Writing" href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<slot name="head" />
</head>
<body>
<slot name="backdrop" />

<header class="bar">
  <a class="mark" href="/">
    <Image src={logoMark} alt="vNick.io" widths={[220, 330, 440]} sizes="150px" loading="eager" />
  </a>
  <nav aria-label="Main">
    <a href="/writing" aria-current={current('/writing')}>Writing</a>
    <a href="/projects" aria-current={current('/projects')}>Projects</a>
    <a href="/about" aria-current={current('/about')}>About</a>
    <a class="ext" href="https://stratora.io">Stratora ↗&#xFE0E;</a>
    <a class="ext" href="https://djneventproductions.com/">DJN ↗&#xFE0E;</a>
  </nav>
</header>

<slot />

<footer>
  <span>© {new Date().getFullYear()} Nick Manganiello · vNick.io, Long Island, New York</span>
  <span class="term">nick@vnick.io</span>
  <span>Built with Astro, hosted on GitHub Pages</span>
</footer>
</body>
</html>
