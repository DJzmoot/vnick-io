---
import Base from '../layouts/Base.astro';
import { getPosts, TOPICS, formatDate, isoDate } from '../lib/posts';

const latest = (await getPosts()).slice(0, 3);
---
<Base
  title="Page not found — vNick.io"
  description="That page doesn't exist on vNick.io. Here's the writing index and the most recent posts."
  noindex={true}
>
  <main>
    <section class="page wrap">
      <h1 class="page-title">Not found</h1>
      <p class="lede">
        That page doesn't exist — it may have been renamed, or the link may be
        wrong. The writing is all still here.
      </p>

      <ul class="posts">
        {latest.map((post) => (
          <li>
            <a href={`/writing/${post.id}`}>
              <span class="k">{TOPICS[post.data.topic]}</span>
              <span class="t">{post.data.title}</span>
              <span class="d"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="post-foot"><a href="/writing">All writing</a> · <a href="/projects">Projects</a> · <a href="/about">About</a></p>
    </section>
  </main>
</Base>
