---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logoFull from '../assets/brand/logo-full.png';
import { getPosts, TOPICS, formatDate, isoDate } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 4);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nick Manganiello',
  alternateName: 'vNick',
  url: 'https://vnick.io/',
  email: 'nick@vnick.io',
  jobTitle: 'Principal Infrastructure Architect',
  description:
    'Infrastructure architect and systems builder: data centers, networks, virtualization, BCDR, cloud, live production and lighting.',
  homeLocation: { '@type': 'Place', name: 'Long Island, New York' },
  sameAs: ['https://stratora.io', 'https://djneventproductions.com/', 'https://github.com/DJzmoot'],
  knowsAbout: [
    'Network infrastructure',
    'Virtualization',
    'Business continuity and disaster recovery',
    'Cloud infrastructure and endpoint management',
    'Lighting design and live event production',
  ],
};
---
<Base
  title="vNick.io — Nick Manganiello — systems, from the rack to the rigging"
  description="Nick Manganiello is an infrastructure architect and systems builder: data centers, networks, virtualization, BCDR, cloud, live production and lighting. Written up from the field."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />

  <Fragment slot="backdrop">
    <canvas class="scene" id="scene" aria-hidden="true"></canvas>
    <div class="vignette"></div>
  </Fragment>

  <main id="top">
    <section class="hero wrap">
      <h1><span>Systems,</span><span>from the rack</span><span>to the rigging.</span></h1>
      <p class="intro">I'm Nick Manganiello — infrastructure architect and systems builder. Data centers, networks, virtualization, BCDR, cloud, live production and lighting — and the physical systems under all of it. Written up from the field.</p>
      <div class="row">
        <a class="btn primary" href="#writing">Read the writing</a>
        <a class="btn ghost" href="#network">Explore the topics</a>
      </div>
    </section>

    <section class="story wrap" id="network">
      <div class="copy">
        <p class="topic">Network Infrastructure</p>
        <h2>Built to carry everything else.</h2>
        <p>Routing, switching, firewalls, SD-WAN, Wi-Fi and structured cabling — from data-center fabrics to campus closets to temporary networks in places that have none.</p>
        <a class="more" href="/writing?topic=network">Network posts</a>
      </div>
    </section>

    <section class="story wrap" id="virtualization">
      <div class="copy">
        <p class="topic">Virtualization Infrastructure</p>
        <h2>A hundred servers in one rack.</h2>
        <p>VMware, Hyper-V and Proxmox: cluster design, storage architecture, replication, and the migrations that move hundreds of workloads without anyone noticing.</p>
        <a class="more" href="/writing?topic=virtualization">Virtualization posts</a>
      </div>
    </section>

    <section class="story wrap" id="bcdr">
      <div class="copy">
        <p class="topic">BCDR Planning &amp; Infrastructure</p>
        <h2>Storage that survives the bad day.</h2>
        <p>Immutable backups, replication, multi-site and cloud DR, ransomware recovery — designed for actual failure scenarios, not checkbox compliance.</p>
        <a class="more" href="/writing?topic=bcdr">BCDR posts</a>
      </div>
    </section>

    <section class="story wrap" id="cloud">
      <div class="copy">
        <p class="topic">Cloud Infrastructure &amp; MDM</p>
        <h2>The data center you don't rack.</h2>
        <p>OCI and OCVS, hybrid cloud, identity with Entra ID, and endpoint architecture with Intune and Autopilot across thousands of devices.</p>
        <a class="more" href="/writing?topic=cloud">Cloud + MDM posts</a>
      </div>
    </section>

    <section class="story wrap" id="lighting">
      <div class="copy">
        <p class="topic">Lighting Design &amp; Programming</p>
        <h2>Networks where there is no network.</h2>
        <p>Concert, theatrical and architectural lighting; DMX, Art-Net and pixel systems; FOH sound — and the production networks built onsite for shows in places with no infrastructure at all.</p>
        <a class="more" href="/writing?topic=lighting">Lighting + Production posts</a>
      </div>
    </section>

    <div class="solid">
      <section class="writing wrap" id="writing">
        <h2>Latest writing</h2>
        <ul class="posts">
          {latest.map((post) => (
            <li>
              <a href={`/writing/${post.id}`}>
                <span class="k">{TOPICS[post.data.topic]}</span>
                <span class="t">{post.data.title}{post.data.draft && <span class="draft-badge">Draft</span>}</span>
                <span class="d"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></span>
              </a>
            </li>
          ))}
          {latest.length === 0 && <li class="posts-empty">Writing is on the way — the first posts are being racked and stacked.</li>}
        </ul>
        <a class="all" href="/writing">All posts</a>
      </section>

      <section class="elsewhere wrap" id="elsewhere">
        <a href="https://stratora.io"><span class="name">Stratora</span><span class="what">Founder. Self-hosted infrastructure monitoring and operational visibility for real-world IT and OT environments.</span></a>
        <a href="https://djneventproductions.com/"><span class="name">DJN Event Productions</span><span class="what">My company. Professional event production, and permanent AV, lighting and sound installation for venues.</span></a>
      </section>

      <div class="signoff wrap">
        <Image src={logoFull} alt="" widths={[520, 780, 1040]} sizes="520px" loading="lazy" />
      </div>
    </div>
  </main>

  <script>
    import { initRack } from '../scripts/rack';
    initRack();
  </script>
</Base>
