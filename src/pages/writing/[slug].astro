---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, TOPICS, formatDate, isoDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — vNick.io`} description={post.data.description}>
  <main>
    <article class="page wrap">
      <header class="post-head">
        <p class="meta">
          <a class="topic" href={`/writing?topic=${post.data.topic}`}>{TOPICS[post.data.topic]}</a>
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          {post.data.draft && <span class="draft-badge">Draft</span>}
        </p>
        <h1>{post.data.title}</h1>
        <p class="desc">{post.data.description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <p class="post-foot"><a href="/writing">← All writing</a></p>
    </article>
  </main>
</Base>
