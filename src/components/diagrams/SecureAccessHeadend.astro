---
import Diagram from '../Diagram.astro';
---
<Diagram caption="Sites enter Cisco Secure Access at a nearby region; the regions are interconnected by Cisco's backbone; and the data centers terminate redundant IPsec with eBGP on the regions closest to them. So an APAC site reaching the East Coast data center can enter locally, cross the backbone, and leave beside the destination rather than taking whatever long-haul path it would otherwise get.">
  <svg viewBox="0 0 760 410" role="img" aria-labelledby="saTitle saDesc">
    <title id="saTitle">Cisco Secure Access regions, the backbone between them, and the IPsec and eBGP handoff into the data centers</title>
    <desc id="saDesc">
      Meraki site regions — Northeast, Canada, West Coast, Europe and APAC — each enter
      Cisco Secure Access at a nearby region: New York with Ashburn, Toronto with
      Vancouver, Palo Alto with Los Angeles, and regional pairs in Europe and APAC. Those
      Secure Access regions are interconnected by Cisco's backbone, so long-haul traffic
      can cross between regions inside the fabric. The East and West data centers
      establish redundant IPsec tunnels with eBGP to the Secure Access regions nearest
      them, and routes are exchanged dynamically rather than kept as static routes.
    </desc>

    <!-- column titles -->
    <text class="panel-title" x="10" y="40">MERAKI SITE REGIONS</text>
    <text class="panel-title" x="228" y="40">CISCO SECURE ACCESS</text>
    <text class="panel-title" x="610" y="40">DATA CENTERS</text>

    <!-- panels -->
    <rect class="panel" x="10" y="52" width="140" height="296" rx="12" />
    <rect class="panel" x="228" y="52" width="272" height="296" rx="12" />
    <rect class="panel" x="610" y="52" width="140" height="296" rx="12" />

    <!-- site regions -->
    <rect class="node" x="22" y="71" width="116" height="30" rx="6" />
    <text class="label" x="34" y="91">Northeast</text>
    <rect class="node" x="22" y="128" width="116" height="30" rx="6" />
    <text class="label" x="34" y="148">Canada</text>
    <rect class="node" x="22" y="185" width="116" height="30" rx="6" />
    <text class="label" x="34" y="205">West Coast</text>
    <rect class="node" x="22" y="242" width="116" height="30" rx="6" />
    <text class="label" x="34" y="262">Europe</text>
    <rect class="node" x="22" y="299" width="116" height="30" rx="6" />
    <text class="label" x="34" y="319">APAC</text>

    <!-- site region into its nearby secure access region -->
    <text class="sub" x="189" y="76" text-anchor="middle">local entry</text>
    <path class="link" d="M150 86 L236 86" /><path class="link" d="M228 80 L236 86 L228 92" />
    <path class="link" d="M150 143 L236 143" /><path class="link" d="M228 137 L236 143 L228 149" />
    <path class="link" d="M150 200 L236 200" /><path class="link" d="M228 194 L236 200 L228 206" />
    <path class="link" d="M150 257 L236 257" /><path class="link" d="M228 251 L236 257 L228 263" />
    <path class="link" d="M150 314 L236 314" /><path class="link" d="M228 308 L236 314 L228 320" />

    <!-- secure access regions -->
    <rect class="node-edge" x="242" y="64" width="244" height="44" rx="8" />
    <text class="label" x="256" y="84">New York + Ashburn</text>
    <text class="sub" x="256" y="100">Northeast pair</text>
    <rect class="node-edge" x="242" y="121" width="244" height="44" rx="8" />
    <text class="label" x="256" y="141">Toronto + Vancouver</text>
    <text class="sub" x="256" y="157">Canada pair</text>
    <rect class="node-edge" x="242" y="178" width="244" height="44" rx="8" />
    <text class="label" x="256" y="198">Palo Alto + Los Angeles</text>
    <text class="sub" x="256" y="214">West Coast pair</text>
    <rect class="node-edge" x="242" y="235" width="244" height="44" rx="8" />
    <text class="label" x="256" y="255">Europe regions</text>
    <text class="sub" x="256" y="271">regional pairs</text>
    <rect class="node-edge" x="242" y="292" width="244" height="44" rx="8" />
    <text class="label" x="256" y="312">APAC regions</text>
    <text class="sub" x="256" y="328">regional pairs</text>

    <!-- each region onto the backbone -->
    <line class="link-active" x1="486" y1="86" x2="520" y2="86" />
    <line class="link-active" x1="486" y1="143" x2="520" y2="143" />
    <line class="link-active" x1="486" y1="200" x2="520" y2="200" />
    <line class="link-active" x1="486" y1="257" x2="520" y2="257" />
    <line class="link-active" x1="486" y1="314" x2="520" y2="314" />

    <!-- the backbone itself -->
    <path class="backbone" d="M520 86 L520 314" />
    <circle class="junction" cx="520" cy="86" r="4" />
    <circle class="junction" cx="520" cy="143" r="4" />
    <circle class="junction" cx="520" cy="200" r="4" />
    <circle class="junction" cx="520" cy="257" r="4" />
    <circle class="junction" cx="520" cy="314" r="4" />

    <!-- data centers terminate on the regions nearest them -->
    <line class="link-active" x1="520" y1="86" x2="602" y2="86" />
    <path class="link-active" d="M594 80 L602 86 L594 92" />
    <text class="sub" x="561" y="78" text-anchor="middle">IPsec + eBGP</text>

    <line class="link-active" x1="520" y1="200" x2="602" y2="200" />
    <path class="link-active" d="M594 194 L602 200 L594 206" />
    <text class="sub" x="561" y="192" text-anchor="middle">IPsec + eBGP</text>

    <rect class="node" x="622" y="57" width="116" height="58" rx="8" />
    <text class="label" x="636" y="81">East DC</text>
    <text class="sub" x="636" y="98">internal prefixes</text>
    <rect class="node" x="622" y="171" width="116" height="58" rx="8" />
    <text class="label" x="636" y="195">West DC</text>
    <text class="sub" x="636" y="212">internal prefixes</text>

    <!-- legend -->
    <path class="backbone" d="M16 370 L56 370" />
    <text class="sub" x="66" y="374">Cisco Secure Access backbone between regions</text>
    <line class="link-active" x1="16" y1="392" x2="56" y2="392" />
    <text class="sub" x="66" y="396">dynamic route exchange over eBGP — no static route matrix</text>
  </svg>
</Diagram>

<style is:global>
.diagram .backbone{ stroke:var(--signal); stroke-width:4; fill:none; stroke-linecap:round; }
.diagram .junction{ fill:var(--signal); }
</style>
